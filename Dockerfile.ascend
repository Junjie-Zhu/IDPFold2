FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CONDA_DIR=/opt/conda
ENV PATH=${CONDA_DIR}/bin:${PATH}
ARG TORCH_PACKAGE="torch==2.6.0"
ARG PYG_PACKAGE="torch-geometric==2.6.1"
ARG TORCH_NPU_PACKAGE="torch-npu==2.6.0.post3"
ARG MINIFORGE_URL="https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-aarch64.sh"
ARG MINIFORGE_LOCAL_FILE=""
ARG CANN_TOOLKIT_RUN="Ascend-cann-toolkit_8.2.RC1_linux-aarch64.run"
ARG CANN_KERNELS_RUN="Ascend-cann-kernels-910b_8.2.RC1_linux-aarch64.run"

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    bzip2 \
    ca-certificates \
    curl \
    gcc \
    g++ \
    git \
    make \
    procps \
    python3-dev \
    python3 \
    python3-pip \
    vim \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/IDPFold-multimer
COPY . /workspace/IDPFold-multimer

# Install Miniforge from a pre-downloaded file if provided; otherwise download from URL.
RUN if [ -n "${MINIFORGE_LOCAL_FILE}" ] && [ -f "/workspace/IDPFold-multimer/${MINIFORGE_LOCAL_FILE}" ]; then \
        cp "/workspace/IDPFold-multimer/${MINIFORGE_LOCAL_FILE}" /tmp/miniforge.sh; \
    else \
        wget -qO /tmp/miniforge.sh "${MINIFORGE_URL}"; \
    fi \
    && bash /tmp/miniforge.sh -b -p ${CONDA_DIR} \
    && rm -f /tmp/miniforge.sh

# Install CANN toolkit and kernels BEFORE creating conda env.
# The two .run files must exist in the repository root during docker build.
RUN test -f "/workspace/IDPFold-multimer/${CANN_TOOLKIT_RUN}" \
    || (echo "Missing toolkit installer: /workspace/IDPFold-multimer/${CANN_TOOLKIT_RUN}" && exit 1)
RUN test -f "/workspace/IDPFold-multimer/${CANN_KERNELS_RUN}" \
    || (echo "Missing kernels installer: /workspace/IDPFold-multimer/${CANN_KERNELS_RUN}" && exit 1)

RUN chmod +x "/workspace/IDPFold-multimer/${CANN_TOOLKIT_RUN}" \
    && ("/workspace/IDPFold-multimer/${CANN_TOOLKIT_RUN}" --install --quiet || yes Y | "/workspace/IDPFold-multimer/${CANN_TOOLKIT_RUN}" --install)

RUN chmod +x "/workspace/IDPFold-multimer/${CANN_KERNELS_RUN}" \
    && ("/workspace/IDPFold-multimer/${CANN_KERNELS_RUN}" --install --quiet || yes Y | "/workspace/IDPFold-multimer/${CANN_KERNELS_RUN}" --install)

# Persist CANN environment for interactive shells (support both default install locations).
RUN if [ -f "/usr/local/Ascend/ascend-toolkit/set_env.sh" ]; then \
        printf '%s\n' "source /usr/local/Ascend/ascend-toolkit/set_env.sh" > /etc/profile.d/ascend-env.sh; \
    elif [ -f "/root/Ascend/ascend-toolkit/set_env.sh" ]; then \
        printf '%s\n' "source /root/Ascend/ascend-toolkit/set_env.sh" > /etc/profile.d/ascend-env.sh; \
    else \
        echo "CANN set_env.sh not found in /usr/local/Ascend or /root/Ascend" && exit 1; \
    fi

RUN cp /workspace/IDPFold-multimer/docker/ascend_entrypoint.sh /usr/local/bin/ascend_entrypoint.sh \
    && chmod +x /usr/local/bin/ascend_entrypoint.sh

RUN conda create -n idpfold2 -y python=3.11 pip \
    && conda run -n idpfold2 pip install --no-cache-dir setuptools wheel \
    && conda run -n idpfold2 pip install --no-cache-dir attrs cython numpy==1.24.0 decorator sympy cffi pyyaml pathlib2 psutil protobuf==3.20 scipy requests absl-py \
    && conda run -n idpfold2 pip install --no-cache-dir einops==0.6 dm-tree==0.1.8 loguru==0.7.2 hydra-core==1.3.1 pandas==1.5.3 biotite==0.41.0 biopandas==0.5.1 wget==3.2 tqdm==4.66.4 cpdb-protein biopython rootutils \
    && conda run -n idpfold2 pip install --no-cache-dir pyyaml setuptools \
    && conda run -n idpfold2 pip install --no-cache-dir ${TORCH_PACKAGE} \
    && conda run -n idpfold2 pip install --no-cache-dir ${PYG_PACKAGE} \
    && conda run -n idpfold2 pip install --no-cache-dir ${TORCH_NPU_PACKAGE} \
    && conda run -n idpfold2 pip install --no-cache-dir fair-esm \
    && conda run -n idpfold2 pip install --no-cache-dir . \
    && conda clean -a -y

ENV PATH=${CONDA_DIR}/envs/idpfold2/bin:${CONDA_DIR}/bin:${PATH}
ENV CONDA_DEFAULT_ENV=idpfold2

ENTRYPOINT ["/usr/local/bin/ascend_entrypoint.sh"]
CMD ["/bin/bash"]
